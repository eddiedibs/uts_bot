# Copy to .env and fill in values: cp .env.example .env
#
# API (required)
API_KEY=change-me-to-a-long-random-secret
API_LISTEN=:8080
API_PORT=8080

# SAIA / Moodle scraper (required for sync)
UTS_USERNAME=
UTS_PASSWORD=
# Optional overrides:
# SAIA_PAGE=https://saia.uft.edu.ve/
# COURSE_VIEW_BASE_URL=https://saia.uft.edu.ve/course/view.php

# Pagos portal (required for /api/v1/payment-fees)
PAGOS_CI=
PAGOS_PASSWORD=
# Optional override:
# PAGOS_API_BASE_URL=https://uftapp.uft.edu.ve/

# MySQL — use host "db" when running API inside Docker Compose
DATABASE_DSN=uts:uts_pass_change_me@tcp(db:3306)/uft_db?parseTime=true&charset=utf8mb4

# Compose MySQL service (defaults match DATABASE_DSN user/pass above)
MYSQL_ROOT_PASSWORD=uts_root_change_me
MYSQL_USER=uts
MYSQL_PASSWORD=uts_pass_change_me
MYSQL_PUBLISH_PORT=3306

# Background scrape scheduler. This is what makes the DB change on its own, which is what
# uts_notifier tails; without it nothing is scraped until an HTTP endpoint is called.
SCRAPE_ENABLED=true

# How long to rest after a cycle FINISHES before starting the next one. Measured from the end
# of the previous cycle, not on a fixed schedule, so cycles can never overlap. Total time
# between cycle starts is therefore this plus however long a cycle takes.
SCRAPE_INTERVAL=120m

# How long to wait after the process starts before the first cycle. Just enough for migrations
# and the DB pool to settle; without it a fresh boot would be blind for a full SCRAPE_INTERVAL.
# Set to 0 to scrape immediately on start. Note every restart pays this and then runs a full
# cycle, so raise it if you restart the container frequently.
SCRAPE_STARTUP_DELAY=2m

# Pacing within a cycle. Activities are crawled one course at a time with SCRAPE_COURSE_REST
# between them, so the crawl trickles into SAIA instead of arriving as a burst. After the last
# course, SCRAPE_PHASE_REST passes before the grade reports are collected back to back.
# Raising either automatically extends the cycle deadline, so cycles are never truncated.
SCRAPE_COURSE_REST=2m
SCRAPE_PHASE_REST=5m

# Local-time window [start, end) in which a cycle may start. Use 0-24 for all day.
# NOTE: this is the *container's* clock. The runtime image has no tzdata and no TZ set, so it
# is UTC unless you change that -- see the timezone note in uts_notifier/README.md.
SCRAPE_ACTIVE_HOURS=7-23

# How long delivered notification_outbox rows are kept. Unconsumed rows are never pruned, so a
# notifier that was offline for a while still receives its backlog.
OUTBOX_RETENTION_DAYS=14

# Password for the least-privilege user uts_notifier connects with. Provision it once with:
#   docker compose exec -T db mysql -uroot -p"$MYSQL_ROOT_PASSWORD" < scripts/notifier_user.sql
NOTIFIER_DB_PASSWORD=change_me_notifier_db_password
